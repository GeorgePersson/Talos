{
  "name": "talos-qa",
  "version": "1.0.0-rc.2",
  "description": "Talos: isolated website and inbox groups for multi-account QA testing.",
  "private": true,
  "desktopName": "org.talosqa.desktop.desktop",
  "main": "dist/main.js",
  "license": "MIT",
  "author": "Talos contributors",
  "homepage": "https://github.com/GeorgePersson/Talos#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeorgePersson/Talos.git"
  },
  "bugs": {
    "url": "https://github.com/GeorgePersson/Talos/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "start:automation": "npm run build && electron . --qa-automation",
    "playwright:connect": "node scripts/playwright-live.cjs",
    "demo": "node scripts/fixture-server.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests integrations playwright.config.ts package.json tsconfig.json .github",
    "format:check": "prettier --check src scripts tests integrations playwright.config.ts package.json tsconfig.json .github",
    "release:checksums": "node scripts/release-manifest.mjs",
    "test": "npm run build && playwright test",
    "check": "npm run typecheck && npm test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:windows": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "electron": "44.6.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "org.talosqa.desktop",
    "productName": "Talos",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "integrations/playwright",
        "to": "playwright-adapter",
        "filter": [
          "*.cjs",
          "README.md"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icon-mac.png",
      "artifactName": "Talos-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "assets/icon.png",
      "executableName": "talos",
      "artifactName": "Talos-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true,
      "executableArgs": [],
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "Talos",
          "Comment": "Multi-account QA browser",
          "Keywords": "QA;Testing;Browser;Playwright;",
          "StartupWMClass": "org.talosqa.desktop"
        }
      },
      "extraFiles": [
        {
          "from": "scripts/install-linux.sh",
          "to": "install.sh"
        },
        {
          "from": "assets/icon.png",
          "to": "talos.png"
        },
        {
          "from": "docs/linux.md",
          "to": "LINUX.md"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
